{
  "name": "ace-omni-cf",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native resurrection of ACE Omni — configurable TRS research laboratory",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/worker & npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=packages/test-support",
    "db:migrate:local": "npm run db:migrate:local --workspace=apps/worker",
    "seed:local": "npm run seed:local --workspace=apps/worker",
    "deploy:dry-run": "npm run deploy:dry-run --workspace=apps/worker"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE"
}
