# Copy to .dev.vars for local wrangler
ENVIRONMENT=development
SESSION_SECRET=local-only-session-secret-32-bytes-minimum-change-me
TOKEN_SIGNING_SECRET=local-only-token-signing-secret-32-bytes-minimum-change-me
SCHEDULE_SIGNING_SECRET=local-only-schedule-signing-secret-32-bytes-minimum-change-me
